---
interface Props {
  roles?: string[];
}

const { roles = [] } = Astro.props;

const API_URL = import.meta.env.PUBLIC_API_URL
---

<div
  class="hidden"
  aria-hidden="true"
  data-auth-guard
  data-api-url={API_URL}
  data-required-roles={JSON.stringify(roles)}
></div>

<script>
  const guards = document.querySelectorAll<HTMLElement>(
    "[data-auth-guard]"
  );

  guards.forEach(async (guard) => {
    const apiUrl = guard.dataset.apiUrl;

    if (!apiUrl) {
      console.error("[AuthGuard] API_URL está vacío.");
      return;
    }

    let requiredRoles: string[];

    try {
      requiredRoles = JSON.parse(
        guard.dataset.requiredRoles || "[]"
      );
    } catch (error) {
      console.error(
        "[AuthGuard] No se pudieron leer los roles requeridos:",
        error
      );
      return;
    }

    const token = localStorage.getItem("access_token");

    const returnTo =
      window.location.pathname +
      window.location.search +
      window.location.hash;

    const loginUrl = new URL("/login", window.location.origin);

    const redirectToLogin = (
      error: string,
      preserveReturnTo = true
    ) => {
      loginUrl.searchParams.set("error", error);

      if (preserveReturnTo) {
        loginUrl.searchParams.set("returnTo", returnTo);
      }

      window.location.replace(loginUrl.toString());
    };

    if (!token) {
      redirectToLogin("session");
      return;
    }

    try {
      console.log("[AuthGuard] Comprobando sesión:", {
        endpoint: `${apiUrl}/auth/me`,
        tokenExists: true,
        requiredRoles,
      });

      const apiResponse = await fetch(`${apiUrl}/auth/me`, {
        method: "GET",
        headers: {
          Authorization: `Bearer ${token}`,
          Accept: "application/json",
        },
      });

      const responseText = await apiResponse.text();

      let user;

      try {
        user = JSON.parse(responseText);
      } catch {
        console.error(
          "[AuthGuard] La API no devolvió JSON:",
          {
            status: apiResponse.status,
            response: responseText,
          }
        );

        redirectToLogin("connection");
        return;
      }

      console.log("[AuthGuard] Respuesta de /auth/me:", {
        status: apiResponse.status,
        user,
      });

      if (!apiResponse.ok) {
        console.error(
          "[AuthGuard] La API rechazó el token:",
          apiResponse.status,
          user
        );

        localStorage.removeItem("access_token");
        redirectToLogin("session");
        return;
      }

      // Admite roles como ["ADMIN"] o [{ nombre: "ADMIN" }].
      const rawRoles = Array.isArray(user.roles)
        ? user.roles
        : [];

      const userRoles: string[] = rawRoles
        .map((role: string | { nombre?: string }) =>
          typeof role === "string" ? role : role?.nombre
        )
        .filter(
          (role: string | undefined): role is string =>
            typeof role === "string"
        );

      const hasPermission =
        requiredRoles.length === 0 ||
        requiredRoles.some((role) => userRoles.includes(role));

      if (!hasPermission) {
        console.warn("[AuthGuard] El usuario no tiene permisos:", {
          requiredRoles,
          userRoles,
        });

        loginUrl.searchParams.set("error", "forbidden");
        loginUrl.searchParams.set(
          "required",
          requiredRoles.join(", ")
        );
        loginUrl.searchParams.set(
          "actual",
          userRoles.join(", ") || "Sin roles"
        );

        loginUrl.searchParams.delete("returnTo");

        window.location.replace(loginUrl.toString());
        return;
      }

      console.log("[AuthGuard] Sesión y permisos comprobados.");
    } catch (error) {
      console.error(
        "[AuthGuard] Error de conexión al comprobar la sesión:",
        error
      );

      redirectToLogin("connection");
    }
  });
</script>
