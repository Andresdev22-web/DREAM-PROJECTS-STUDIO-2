---
import "../style/global.css";
import { LayoutLandingPage, Header } from "lity-ui";

const GOOGLE_CLIENT_ID = import.meta.env.GOOGLE_CLIENT_ID || "";
const API_URL = import.meta.env.PUBLIC_API_URL
---

<LayoutLandingPage titlePage="Iniciar sesión | DREAM PROJECTS STUDIO">
  <Header
    slot="header"
    title="DREAM PROJECTS STUDIO"
    logoImg="/logo.webp"
    showNavigation={true}
    navigationTitle="Navegación"
    navigationLinks={[
      { label: "Inicio", href: "/#inicio", icon: "lucide:house" },
    ]}
    showThemeSelector={true}
    sticky={true}
  />

  <main
    class="relative flex min-h-[calc(100vh-5rem)] items-center justify-center overflow-hidden bg-[var(--bg-primary)] px-4 py-16 text-[var(--text-primary)]"
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -left-32 top-20 h-72 w-72 rounded-full bg-[var(--color-primary)]/10 blur-[100px]"
    ></div>

    <div
      aria-hidden="true"
      class="pointer-events-none absolute -right-32 bottom-10 h-72 w-72 rounded-full bg-[var(--color-secondary)]/10 blur-[100px]"
    ></div>

    <section
      class="relative z-10 w-full max-w-md rounded-2xl border border-[var(--border-color)] bg-[var(--bg-secondary)] p-7 shadow-2xl shadow-black/30 sm:p-10"
    >
      <div class="mb-8 text-center">
        <img
          src="/logo.webp"
          alt="DREAM PROJECTS STUDIO"
          width="96"
          height="96"
          class="mx-auto h-24 w-24 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-tertiary)] object-contain p-2"
        />

        <p class="mt-5 text-xs font-bold tracking-[0.25em] text-[var(--accent)]">
          DREAM PROJECTS STUDIO
        </p>

        <h1 class="mt-3 text-3xl font-bold tracking-tight">
          Bienvenido
        </h1>

        <p class="mt-3 text-sm leading-6 text-[var(--text-secondary)]">
          Inicia sesión para continuar y acceder a tu cuenta.
        </p>
      </div>

      <div
        id="login-error"
        class="mb-5 hidden rounded-xl border border-[var(--color-primary)]/30 bg-[var(--color-primary)]/10 p-4 text-sm leading-6 text-[var(--text-primary)]"
        role="alert"
        aria-live="assertive"
      ></div>

      <div
        id="google-button-container"
        class="flex min-h-11 justify-center"
      ></div>

      <p
        id="login-status"
        class="mt-4 hidden text-center text-sm leading-6 text-[var(--text-secondary)]"
        role="status"
        aria-live="polite"
      ></p>

      <div class="my-7 flex items-center gap-4">
        <div class="h-px flex-1 bg-[var(--border-color)]"></div>
        <span class="text-xs text-[var(--text-muted)]">
          ACCESO SEGURO
        </span>
        <div class="h-px flex-1 bg-[var(--border-color)]"></div>
      </div>

      <p class="text-center text-xs leading-6 text-[var(--text-muted)]">
        Utiliza tu cuenta de Google para identificarte y acceder
        a las funciones habilitadas para tu usuario.
      </p>

      <a
        href="/"
        class="mt-7 flex items-center justify-center gap-2 text-sm text-[var(--text-secondary)] transition hover:text-[var(--text-primary)]"
      >
        <span aria-hidden="true">←</span>
        Volver al inicio
      </a>
    </section>
  </main>
</LayoutLandingPage>

<script define:vars={{ GOOGLE_CLIENT_ID, API_URL }}>
  const errorBox = document.querySelector("#login-error");
  const statusBox = document.querySelector("#login-status");
  const googleContainer = document.querySelector(
    "#google-button-container"
  );

  const params = new URLSearchParams(window.location.search);

  function showError(message) {
    if (!errorBox) return;

    errorBox.textContent = message;
    errorBox.classList.remove("hidden");
  }

  function showStatus(message) {
    if (!statusBox) return;

    statusBox.textContent = message;
    statusBox.classList.toggle("hidden", !message);
  }

  function getReturnTo() {
    const path = params.get("returnTo");

    if (path && path.startsWith("/") && !path.startsWith("//")) {
      return path;
    }

    return "/";
  }

  // Mostrar el motivo de una redirección al login.
  const error = params.get("error");

  if (error === "forbidden") {
    const required = params.get("required") || "No especificado";
    const actual = params.get("actual") || "Sin roles";

    showError(
      `No tienes permiso para acceder a esa página. ` +
      `Se requiere uno de estos roles: ${required}. ` +
      `Tus roles actuales: ${actual}.`
    );
  } else if (error === "session") {
    showError(
      "Tu sesión ha expirado o no es válida. Inicia sesión nuevamente."
    );
  } else if (error === "connection") {
    showError(
      "No se pudo comprobar tu sesión. Verifica tu conexión e inténtalo de nuevo."
    );
  }

  // Comprobar la configuración de Google.
  if (!GOOGLE_CLIENT_ID) {
    showError(
      "Falta configurar GOOGLE_CLIENT_ID en el archivo .env."
    );
  } else {
    const googleScript = document.createElement("script");

    googleScript.src = "https://accounts.google.com/gsi/client";
    googleScript.async = true;

    googleScript.onload = () => {
      const google = window.google;

      if (!google?.accounts?.id || !googleContainer) {
        showError("No se pudo cargar el inicio de sesión de Google.");
        return;
      }

      google.accounts.id.initialize({
        client_id: GOOGLE_CLIENT_ID,

        callback: async (googleResponse) => {
          try {
            if (!googleResponse.credential) {
              throw new Error(
                "Google no devolvió un token válido."
              );
            }

            showStatus("Iniciando sesión...");
            googleContainer.classList.add(
              "pointer-events-none",
              "opacity-50"
            );

            // Solo hacemos UNA petición a nuestra API.
            const apiResponse = await fetch(
              `${API_URL}/auth/google`,
              {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                },
                body: JSON.stringify({
                  token: googleResponse.credential,
                }),
              }
            );

            // Leer primero como texto evita el error
            // Unexpected token '<' si el servidor devuelve HTML.
            const responseText = await apiResponse.text();

            let result;

            try {
              result = JSON.parse(responseText);
            } catch {
              console.error(
                "Respuesta no válida de la API:",
                {
                  url: `${API_URL}/auth/google`,
                  status: apiResponse.status,
                  response: responseText,
                }
              );

              throw new Error(
                `La API devolvió una respuesta que no es JSON ` +
                `(HTTP ${apiResponse.status}). Revisa la consola.`
              );
            }

            if (!apiResponse.ok) {
              const detail = result.detail;

              throw new Error(
                typeof detail === "string"
                  ? detail
                  : Array.isArray(detail)
                    ? detail.map((item) => item.msg || "").filter(Boolean).join(", ")
                    : "No se pudo iniciar sesión."
              );
            }

            if (!result.access_token) {
              throw new Error(
                "La API no devolvió el campo access_token."
              );
            }

            // Guardar el JWT emitido por nuestra propia API.
            localStorage.setItem(
              "access_token",
              result.access_token
            );

            // Regresar a la página que solicitó autenticación.
            window.location.replace(getReturnTo());
          } catch (error) {
            googleContainer?.classList.remove(
              "pointer-events-none",
              "opacity-50"
            );

            showStatus("");

            showError(
              error instanceof Error
                ? error.message
                : "Ocurrió un error al iniciar sesión."
            );
          }
        },
      });

      google.accounts.id.renderButton(googleContainer, {
        type: "standard",
        theme: "filled_black",
        size: "large",
        shape: "rectangular",
        text: "continue_with",
        width: 320,
        locale: "es",
      });
    };

    googleScript.onerror = () => {
      showError("No se pudo cargar el servicio de Google.");
    };

    document.head.appendChild(googleScript);
  }
</script>

<script>
  export {};

  declare global {
    interface Window {
      google?: {
        accounts: {
          id: {
            initialize: (options: {
              client_id: string;
              callback: (response: {
                credential: string;
              }) => void;
            }) => void;

            renderButton: (
              parent: HTMLElement,
              options: Record<string, string | number>
            ) => void;
          };
        };
      };
    }
  }
</script>
